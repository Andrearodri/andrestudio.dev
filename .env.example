# Configuração de ambiente exclusivamente server-side (Cloudflare Pages Secrets / .env local).
# Nunca preencha chaves reais neste arquivo ou comite .env no Git.
# Sem nenhuma chave configurada, o Auditor IA opera 100% em modo contingência local determinístico.

# Provedor preferencial opcional: gemini | openai | workers-ai
AI_PROVIDER=
# Modelo opcional (defaults: gemini-2.5-flash, gpt-4o-mini, @cf/meta/llama-3.1-8b-instruct)
AI_MODEL_ID=

# Chave do Google Gemini (Pages Secret recomendado)
GEMINI_API_KEY=

# Chave da OpenAI (Pages Secret alternativo)
OPENAI_API_KEY=

# Webhook HTTPS opcional para receber cópia dos leads capturados (Make / n8n / CRM)
LEAD_WEBHOOK_URL=

# Bindings opcionais no painel Cloudflare Pages > Settings > Functions:
# - AI (Workers AI binding)
# - RATE_LIMIT_KV (KV Namespace para rate limit distribuído)
# - LEADS_KV (KV Namespace para armazenar leads do Auditor)
# - DB (D1 Database para tabela auditor_leads)
